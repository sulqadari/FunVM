// true AND true
if (1 + 1 == 2 and 2 + 3 == 5) {
	print(1);
} else {
	print(0);
}

// false AND true
if (1 + 1 == 3 and 2 + 3 == 5) {
	print(0);
} else {
	print(1);
}

// true AND false
if (1 + 1 == 2 and 2 + 3 == 4) {
	print(0);
} else {
	print(1);
}

// false AND false
if (1 + 1 == 3 and 2 + 3 == 4) {
	print(0);
} else {
	print(1);
}

// true OR true
if (1 + 1 == 2 or 2 + 3 == 5) {
	print(1);
} else {
	print(0);
}

// false OR true
if (1 + 1 == 3 or 2 + 3 == 5) {
	print(1);
} else {
	print(0);
}

// true OR false
if (1 + 1 == 2 or 2 + 3 == 4) {
	print(1);
} else {
	print(0);
}

// false OR false
if (1 + 1 == 3 or 2 + 3 == 4) {
	print(0);
} else {
	print(1);
}