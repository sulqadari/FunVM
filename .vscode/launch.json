	"version": "0.2.0",
	"configurations": [
		{
			"name": "FunVM Compiler",
			"type": "cppdbg",
			"request": "launch",
			"program": "${workspaceFolder}/build/bin/FVMCexe",
			"args": [
				"constants_test.fv",
				"./tests/",
				"./tests/bin/"
			],
			"cwd": "${workspaceFolder}",
			"stopAtEntry": true
		},
		{
			"name": "FunVM Virtual machine",
			"type": "cppdbg",
			"request": "launch",
			"program": "${workspaceFolder}/build/bin/FVMexe",
			"args": [
				"${workspaceFolder}/tests/bin/constants_test.fvb"
			],
			"cwd": "${workspaceFolder}",
			"stopAtEntry": true
		},
		{
			"name": "FunVM heap",
			"type": "cppdbg",
			"request": "launch",
			"program": "${workspaceFolder}/build/bin/heap_test",
			"args": [
			],
			"cwd": "${workspaceFolder}",
			"stopAtEntry": true
		},
		{
			"name": "FunVM heap realloc",
			"type": "cppdbg",
			"request": "launch",
			"program": "${workspaceFolder}/build/bin/heap_realloc_test",
			"args": [
			],
			"cwd": "${workspaceFolder}",
			"stopAtEntry": true
		},
		{
			"name": "FunVM portable serialize",
			"type": "cppdbg",
			"request": "launch",
			"program": "${workspaceFolder}/build/bin/portable_serialize_test",
			"args": [
				"./tests/bin/"
			],
			"cwd": "${workspaceFolder}",
			"stopAtEntry": true
		},
		{
			"name": "FunVM portable deserialize",
			"type": "cppdbg",
			"request": "launch",
			"program": "${workspaceFolder}/build/bin/portable_deserialize_test",
			"args": [
				"./tests/bin/portable_create_test.bin"
			],
			"cwd": "${workspaceFolder}",
			"stopAtEntry": true
		}
		
	]
}